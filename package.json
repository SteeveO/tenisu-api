{
  "name": "tenisu-api",
  "version": "1.0.0",
  "description": "API REST de statistiques de joueurs de tennis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --minify --outfile=dist/api/handler.cjs",
    "dev": "tsx watch --env-file=local.env src/server.ts",
    "dev:memory": "STORAGE=memory tsx watch --env-file=local.env src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "generate:countries": "tsx scripts/generate-countries.ts",
    "prepare:images": "tsx scripts/prepare-images.ts",
    "seed": "tsx --env-file=local.env scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteeveO/tenisu-api.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@hono/aws-lambda": "^1.0.1",
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "flag-icons": "^7.6.0",
    "globals": "^17.14.0",
    "i18n-iso-countries": "^7.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
